flowchart LR

    %% The natural history: what the disease does (every agent has a stage)
    subgraph Stages[Stages: natural history]
        direction LR
        S[Susceptible] -->|infection, if free| L[Latent]
        L -->|drawn duration| P[Prodromal]
        P -->|drawn duration| Ra[Rash]
        Ra -->|drawn duration,<br>or discharge| Re[Recovered]
    end

    %% The statuses: where the agent is (who it meets)
    subgraph Statuses[Statuses: the model's states]
        direction LR
        F[Free]
        Q[Quarantined]
        I[Isolated]
        H[Hospitalized]
        F -->|traced contact| Q
        Q -->|period over| F
        F -->|detected with rash,<br>or traced with rash| I
        Q -->|rash onset| I
        I -->|period over| F
        F -->|rash: daily risk| H
        I -->|rash: daily risk| H
        H -->|discharge| F
    end
