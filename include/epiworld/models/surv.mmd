        s4 ==>|"after: a function"| s6
        s5 ==>|"after: a function, since Asymptomatic"| s6
        s2 -->|"Death<br>rate: Prob. death"| s7
        s3 -->|"Death<br>rate: Prob. death"| s7
        s4 -->|"Death<br>rate: Prob. death"| s7
        s5 -->|"Death<br>rate: Prob. death"| s7
